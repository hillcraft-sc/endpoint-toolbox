            <StackPanel Margin="0,4,12,8">
              <TextBlock Name="WorkflowGuide" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="{StaticResource Spacing.Panel.Margin}"/>
              <StackPanel Name="Form"/>
            </StackPanel>
          </ScrollViewer>
