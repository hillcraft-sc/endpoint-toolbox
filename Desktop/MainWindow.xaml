    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
      <Setter Property="Padding" Value="{StaticResource Padding.Control}"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
          <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
      <Setter Property="BorderThickness" Value="{StaticResource BorderThickness.Default}"/>
      <!-- Replaces the Aero2 template, whose disabled state hard-codes a white background. -->
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
          <ScrollViewer x:Name="Scroller" Focusable="False" Padding="{TemplateBinding Padding}">
            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
          </ScrollViewer>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsGrouping" Value="True"/>
              <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False"/>
            </MultiTrigger.Conditions>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
          </MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
          <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Selected}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
    </Style>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="{DynamicResource Brush.Background.Secondary}"/>
      <Setter Property="Width" Value="{x:Static SystemParameters.VerticalScrollBarWidth}"/>
      <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Border Background="{TemplateBinding Background}">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/></Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Background="{DynamicResource Brush.Text.Muted}">
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Border Background="{TemplateBinding Background}" Margin="3" CornerRadius="{StaticResource CornerRadius.Default}"/>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/></Track.IncreaseRepeatButton>
          </Track>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
            <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="{x:Static SystemParameters.HorizontalScrollBarHeight}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="{StaticResource Padding.Tab}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}" Margin="{StaticResource Spacing.TabItem.Margin}">
          <ContentPresenter x:Name="TabHeader" ContentSource="Header" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource Brush.Accent}"/><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush.Tab.Focus}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="{StaticResource BorderThickness.Focus}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ExpanderHeaderKeyboardFocus" TargetType="Control">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
        <Border BorderBrush="{DynamicResource Brush.Focus}" BorderThickness="{StaticResource BorderThickness.Focus}"/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Margin" Value="{StaticResource Spacing.Expander.Margin}"/><Setter Property="Padding" Value="{StaticResource Padding.Control}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton x:Name="HeaderToggle" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                        Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left"
                        FocusVisualStyle="{StaticResource ExpanderHeaderKeyboardFocus}"
                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="HeaderBorder" BorderBrush="Transparent" BorderThickness="{StaticResource BorderThickness.Focus}" Padding="{StaticResource Padding.Control}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource Icon.Size.Small}" VerticalAlignment="Center" Margin="{StaticResource Spacing.Button.Margin}"/>
                  <ContentPresenter RecognizesAccessKey="True"/>
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" Margin="{TemplateBinding Padding}"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid FocusManager.FocusedElement="{Binding ElementName=Search}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Brush.Background.Secondary}" BorderBrush="{DynamicResource Brush.Border.Divider}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,18,12,12">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Endpoint Toolbox" FontSize="{StaticResource Font.Size.Heading}" FontWeight="SemiBold" Margin="6,0,0,3"/>
          <TextBlock Text="Intune · Entra · Remote support" FontSize="{StaticResource Font.Size.Secondary}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="6,0,0,24"/>
          <TextBlock Text="FIND A TASK" FontSize="{StaticResource Font.Size.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="6,0,0,7"/>
          <TextBox Name="Search" ToolTip="Search by task, category or script name" AutomationProperties.Name="Search tasks" Margin="0,0,4,12"
                   KeyboardNavigation.TabIndex="0"/>
          <Button Name="HomeButton" Content="_Home / Graph connection" HorizontalAlignment="Stretch" Margin="0,0,4,8" AutomationProperties.Name="Home / Graph connection" KeyboardNavigation.TabIndex="1"/>
          <TextBlock Name="SearchEmpty" Text="No matching tasks. Try another search." TextWrapping="Wrap" Visibility="Collapsed"
                     Foreground="{DynamicResource Brush.Text.Secondary}" Margin="6,0,0,8" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
          <Border Height="{StaticResource Control.Height.Divider}" Background="{DynamicResource Brush.Border.Divider}" Margin="0,0,0,12"/>
          <Button Name="SettingsButton" Content="_Settings" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings"
                  AutomationProperties.AcceleratorKey="Ctrl+," Margin="0" HorizontalAlignment="Left" KeyboardNavigation.TabIndex="3"/>
        </StackPanel>
        <ListBox Name="WorkflowList" BorderThickness="0" Background="Transparent" IsSynchronizedWithCurrentItem="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Tasks grouped by category"
                 KeyboardNavigation.TabIndex="2">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.ContainerStyle><Style TargetType="GroupItem">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
                  <Expander Tag="WorkflowCategory" Header="{Binding Name}" Margin="0,2,4,2" Padding="8,0,0,0"
                            Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold">
                    <ItemsPresenter/>
                  </Expander>
                </ControlTemplate></Setter.Value></Setter>
              </Style></GroupStyle.ContainerStyle>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,2,4,2"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="{StaticResource CornerRadius.Default}" BorderBrush="Transparent" BorderThickness="3,0,0,0">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Selection.Hover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Selection}"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Selected}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Focus}"/><Setter TargetName="ItemBorder" Property="BorderThickness" Value="{StaticResource BorderThickness.Focus}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
          </Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" ToolTip="{Binding Path}"/>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ScrollViewer Name="HomePanel" Grid.Column="1" Margin="{StaticResource Spacing.Dialog.Margin}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="Microsoft Graph connection" FontSize="{StaticResource Font.Size.Title}" FontWeight="SemiBold" Margin="{StaticResource Spacing.Panel.Margin}"/>
        <TextBlock Text="Connect once in this app; Graph tasks reuse the same worker session. If the tenant field is empty, Connect uses the default tenant in Settings &gt; Graph, or the account default when that setting is empty. Remote endpoint credentials are separate. No sign-in occurs automatically." TextWrapping="Wrap" Margin="{StaticResource Spacing.Panel.Margin}"/>
        <TextBlock Name="GraphSessionStatus" Text="Sign-in and permissions not verified." TextWrapping="Wrap" Margin="{StaticResource Spacing.Panel.Margin}"
                   AutomationProperties.Name="Graph connection and role status" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Name="GraphTenantLabel" Text="Tenant ID or domain (optional; overrides Settings)" Margin="{StaticResource Spacing.Label.Margin}"/>
        <TextBox Name="GraphTenant" AutomationProperties.Name="Tenant ID or domain (optional; overrides Settings)" AutomationProperties.LabeledBy="{Binding ElementName=GraphTenantLabel}" Margin="{StaticResource Spacing.Field.Margin}"/>
        <WrapPanel Margin="{StaticResource Spacing.Panel.Margin}">
          <Button Name="GraphConnectButton" Content="_Connect / reconnect" Style="{StaticResource PrimaryButton}"/>
          <Button Name="GraphCheckButton" Content="Check connectio_n"/>
          <Button Name="GraphDisconnectButton" Content="_Disconnect Graph"/>
          <Button Name="GraphStopButton" Content="_Stop" IsEnabled="False"/>
        </WrapPanel>
        <Button Name="OpenPimButton" Content="Open Microsoft Entra _PIM" HorizontalAlignment="Left" Margin="{StaticResource Spacing.Panel.Margin}"/>
        <TextBlock Name="GraphSessionDetails" Text="Check connection makes live Graph requests and shows the account, tenant, delegated scopes and active tenant-wide built-in roles. Results are a point-in-time check, not a continuous monitor." TextWrapping="Wrap" Margin="{StaticResource Spacing.Panel.Margin}"/>
        <Expander Name="GraphGuidance" Header="Graph permissions and role requirements">
          <StackPanel>
        <TextBlock Text="Connect uses the existing Microsoft Graph permissions granted to this account/application; it does not request a new bundle of read, write or role-management scopes. PIM activation and application consent are separate. Activate your role in PIM, then check again; the app never activates roles for you." TextWrapping="Wrap" Margin="{StaticResource Spacing.Panel.Margin}"/>
        <TextBlock Text="Before every Graph task, the app checks the live connection, required scopes and active roles again. Most reports require Global Reader or Intune Administrator. Both user sign-in views accept Global Reader, Reports Reader, Security Reader, Security Operator or Security Administrator in app preflight; Graph enforces access to the selected API. Intune changes require Intune Administrator. Group-task preflight accepts Groups Administrator or Intune Administrator; this is not proof of permission to modify the target group. Real Entra / Autopilot cleanup requires both Intune Administrator and Cloud Device Administrator. Global Administrator also satisfies these role checks but is not recommended merely to use this app." TextWrapping="Wrap" Margin="{StaticResource Spacing.Panel.Margin}"/>
        <TextBlock Text="Role eligibility alone is insufficient. Scoped/custom roles and group ownership are not verified. A failed or unreadable check blocks the task before the business script starts. Consent, Intune RBAC, licensing, conditional access, service propagation and role expiry during a run can still cause an operation to fail." TextWrapping="Wrap" Margin="{StaticResource Spacing.Panel.Margin}"/>
          </StackPanel>
        </Expander>
        <Button Name="ReturnToTaskButton" Content="Return to selected _task" HorizontalAlignment="Left"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Name="TaskPanel" Grid.Column="1" Margin="24,18,24,12" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,12">
        <DockPanel>
          <Border Name="RiskBadge" DockPanel.Dock="Right" Background="{DynamicResource Brush.Success}" CornerRadius="5" Padding="{StaticResource Padding.Badge}" VerticalAlignment="Top" Margin="16,0,0,0">
            <TextBlock Name="RiskLabel" Text="Read only" FontSize="{StaticResource Font.Size.Secondary}" FontWeight="SemiBold"
                       AutomationProperties.Name="Workflow risk" AutomationProperties.LiveSetting="Polite"/>
          </Border>
          <StackPanel>
            <TextBlock Name="CategoryLabel" Foreground="{DynamicResource Brush.Accent}" FontSize="{StaticResource Font.Size.Secondary}" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock Name="WorkflowTitle" FontSize="{StaticResource Font.Size.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
        <TextBlock Name="Description" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="21">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsSelected, ElementName=RemoteTab}" Value="True"/>
                <Condition Binding="{Binding IsSelected, ElementName=OutputTab}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Collapsed"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsSelected, ElementName=ResultsTab}" Value="True"/>
                <Condition Binding="{Binding IsSelected, ElementName=OutputTab}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Collapsed"/>
            </MultiDataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </StackPanel>
