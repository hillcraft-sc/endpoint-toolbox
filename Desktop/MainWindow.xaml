                    <Button Name="OpenWUfBUpdates" Content="View selected device's updates" Visibility="Collapsed" IsEnabled="False"
                            AutomationProperties.Name="View selected device's updates" ToolTip="Select cells in one WUfB device row. Uses already retrieved data; no new query."/>
                    <Button Name="OpenWUfBAlerts" Content="View selected device's alerts" Visibility="Collapsed" IsEnabled="False"
