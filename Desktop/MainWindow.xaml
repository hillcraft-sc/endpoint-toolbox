                              ToolTip="Select one error-code row to open its Microsoft Learn reference."/>
                      <Button Name="SearchErrorCode" Content="Search this code" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                              ToolTip="Select one row with a numeric error code. Only its normalized hex value is sent to the search engine."/>
                    </StackPanel>
                  </WrapPanel>
                  <TextBlock DockPanel.Dock="Bottom" Text="Select cells with Shift for a range or Ctrl for individual cells, then press Ctrl+C to copy without headers. Read script output for warnings and action outcomes." FontSize="{StaticResource Font.Size.Secondary}" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                  <DataGrid Name="ResultsGrid" SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader" AutomationProperties.Name="Report data"/>
                </DockPanel>
              </TabItem>
              <TabItem Header="Visual summary" Name="ReportVisualTab" Visibility="Collapsed">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource Spacing.Panel.Margin}">
                    <Label Content="_Report to visualize" Target="{Binding ElementName=ReportVisualSelector}" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ComboBox Name="ReportVisualSelector" DisplayMemberPath="Title" AutomationProperties.Name="Report to visualize" Margin="{DynamicResource Spacing.Button.Margin}"/>
                      <StackPanel Grid.Column="1" IsEnabled="{Binding IsEnabled, ElementName=WorkflowList}">
                        <Button Name="ExportReportVisualButton" Content="Export _PNG..." IsEnabled="False" Margin="0"
                                ToolTip="Save all charts in the selected visual summary, including charts below the visible area."
                                AutomationProperties.HelpText="Exports the selected visual summary as a PNG image, with titles, labels and data-coverage notes."/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="Charts summarize retrieved report data; paging and report scope can limit coverage. Grid filters do not change them."
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="{DynamicResource Spacing.Hint.Margin}"/>
                  </StackPanel>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="ReportVisualPanel"/>
                  </ScrollViewer>
                </DockPanel>
              </TabItem>
              <TabItem Header="Saved reports">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Generated report files and exported visual summary images." Margin="0,0,0,12" TextWrapping="Wrap"/>
                  <Button Name="OpenArtifactButton" DockPanel.Dock="Bottom" Content="_Open selected report" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                  <ListBox Name="Artifacts" DisplayMemberPath="Display" AutomationProperties.Name="Generated reports" BorderBrush="{DynamicResource Brush.Border.Divider}"/>
                </DockPanel>
              </TabItem>
              <TabItem Header="Remote workspace" Name="RemoteTab" Visibility="Collapsed">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*" MinHeight="140"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="2*" MinHeight="128"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Name="RemoteStatus" Text="Disconnected. Commands cannot run locally." TextWrapping="Wrap" Margin="0,0,0,6"
                             AutomationProperties.Name="Remote session status" AutomationProperties.LiveSetting="Polite"/>
                  <DockPanel Grid.Row="1" Background="{DynamicResource Brush.Console.Background}">
                    <TextBlock Name="RemoteBusyIndicator" DockPanel.Dock="Bottom" Visibility="Collapsed" FontFamily="Consolas" Foreground="{DynamicResource Brush.Console.Text}"
                               Padding="{StaticResource Padding.Control}" AutomationProperties.Name="Remote operation running indicator"/>
                    <TextBox Name="RemoteOutput" Style="{StaticResource ConsoleOutput}" AutomationProperties.Name="Remote PowerShell output"/>
                  </DockPanel>
                  <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource Brush.Border.Default}"
                                ToolTip="Drag to resize remote output and command editor" AutomationProperties.Name="Resize remote output and command editor"/>
                  <DockPanel Grid.Row="3">
                  <StackPanel DockPanel.Dock="Top">
                    <ComboBox Name="RemoteCommandPicker" DisplayMemberPath="Name" MaxDropDownHeight="320" IsTextSearchEnabled="True"
                              ToolTip="Select a command to replace the text below. Review or edit it, then click Run on endpoint. Selection never runs it."
                              AutomationProperties.Name="Saved remote commands"/>
                    <ScrollViewer MaxHeight="32" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,4">
                    <TextBlock Name="RemoteCommandDescription" Text="Choose a saved command or type your own. Review the text before clicking Run on endpoint."
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="{StaticResource Font.Size.Secondary}"/>
                    </ScrollViewer>
                  </StackPanel>
                  <TextBox Name="RemoteCommand" AcceptsReturn="True" MinHeight="{StaticResource Control.Height.Multiline}" VerticalContentAlignment="Top"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="{StaticResource Padding.Control}"
                          FontFamily="{StaticResource Font.Family.Monospace}" AutomationProperties.Name="Remote PowerShell command"/>
                  </DockPanel>
                    <WrapPanel Grid.Row="4" Margin="0,8,0,0"><Button Name="SendCommandButton" Style="{StaticResource PrimaryButton}" Content="Run on _endpoint" IsEnabled="False"/>
                      <Button Name="DisconnectButton" Content="Disconnect sessio_n" IsEnabled="False"/>
                      <Button Name="SaveRemoteLogButton" Content="Save remote output..."/></WrapPanel>
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
        </TabItem>
      </TabControl>
      <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border.Divider}" BorderThickness="0,1,0,0" Padding="0,8" Margin="0,8,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Name="CancelButton" Content="_Stop" IsEnabled="False"/>
            <Button Name="BackToRollout" Content="Back to _rollout" Visibility="Collapsed" Margin="{StaticResource Spacing.Button.Margin}"/>
            <Button Name="RunButton" Content="_Run report" Margin="0">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsSelected, ElementName=RemoteTab}" Value="True"/>
                      <Condition Binding="{Binding IsEnabled, ElementName=SendCommandButton}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Elevated}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Button}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style></Button.Style>
            </Button>
          </StackPanel>
          <TextBlock Name="ExecutionHint" Text="Connect on Home before running Graph tasks." TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,18,0"
                     AutomationProperties.Name="Execution guidance" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
      </Border>
      <StackPanel Grid.Row="3">
        <ProgressBar Name="Progress" Height="{StaticResource Control.Height.Progress}" Minimum="0" Maximum="100" Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Border.Subtle}" BorderThickness="0"
                     AutomationProperties.Name="Task progress"/>
        <TextBlock Name="Status" Text="Select a task. Sign-in and permissions not verified." Margin="0,8,0,5" FontSize="{StaticResource Font.Size.Secondary}" TextWrapping="Wrap"
                   AutomationProperties.Name="Task status" AutomationProperties.LiveSetting="Polite"/>
        <Expander Header="Connection &amp; script details" FontSize="{StaticResource Font.Size.Caption}" Margin="0" Padding="0">
          <StackPanel><TextBlock Name="ContextLabel" Text="Sign-in and permissions not verified. Connect or check on Home." TextWrapping="Wrap"/><TextBlock Name="ScriptPath" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
        </Expander>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
